<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos mínimos: descarga HTTPS, estado de red, instalación con confirmación del sistema y avisos. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Visibilidad de paquetes (Android 11+) solo para las aplicaciones gestionadas. Sin QUERY_ALL_PACKAGES. -->
    <queries>
        <package android:name="com.artifex.mupdf.viewer.app" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.quicksupport.addon.universal" />
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
        <package android:name="com.whatsapp" />
        <package android:name="com.google.android.gm" />
        <package android:name="es.empresa.tabletsetup.installer" />
        <package android:name="es.empresa.tabletsetup.updater" />
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.gms" />
    </queries>

    <application>
        <receiver
            android:name="es.empresa.tabletsetup.core.platform.InstallStatusReceiver"
            android:exported="false" />
    </application>
</manifest>
